{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "Milestone": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        }
      },
      "required": ["id", "label"],
      "type": "object"
    },
    "Starter": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Item definition GUID, 32 lowercase hexadecimal digits.",
          "type": "string"
        },
        "name": {
          "description": "The game's car name when the installation provides one.",
          "type": ["string", "null"]
        }
      },
      "required": ["id", "name"],
      "type": "object"
    }
  },
  "properties": {
    "account_id": {
      "type": "string"
    },
    "can_apply": {
      "type": "boolean"
    },
    "completes": {
      "items": {
        "$ref": "#/definitions/Milestone"
      },
      "type": "array"
    },
    "generation": {
      "type": "string"
    },
    "operation_id": {
      "type": "string"
    },
    "plan_id": {
      "description": "Binds the exact save file, account, generation, target and prepared rules.",
      "type": "string"
    },
    "reasons": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "reopens": {
      "items": {
        "$ref": "#/definitions/Milestone"
      },
      "type": "array"
    },
    "source_checkpoint": {
      "type": "string"
    },
    "starter": {
      "default": null,
      "description": "The choice this preview's `plan_id` binds, from `--starter`.",
      "type": ["string", "null"]
    },
    "starters": {
      "default": [],
      "description": "First-car choices, listed only when this change completes the car\nchoice on a save without a starter. Apply then requires one of them.",
      "items": {
        "$ref": "#/definitions/Starter"
      },
      "type": "array"
    },
    "target_checkpoint": {
      "type": "string"
    },
    "version": {
      "const": 1,
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "version",
    "account_id",
    "generation",
    "source_checkpoint",
    "target_checkpoint",
    "operation_id",
    "plan_id",
    "completes",
    "reopens",
    "can_apply",
    "reasons",
    "starters",
    "starter"
  ],
  "title": "Preview",
  "type": "object"
}
