{
  "$schema": "https://schema.tauri.app/config/2/capability",
  "identifier": "default",
  "description": "The main window: custom title bar, folder picker, release links, update checks and restart after an update. Folders are opened through the app's own commands.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize",
    "dialog:allow-open",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://github.com/afterhours-crew/afterhours-2015-launcher/*" },
        { "url": "https://github.com/afterhours-crew/afterhours-2015/*" },
        { "url": "https://www.patreon.com/*" },
        { "url": "https://patreon.com/*" }
      ]
    },
    "updater:default",
    "process:allow-restart"
  ]
}
