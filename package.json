{
  "name": "afterhours-2015-launcher",
  "private": true,
  "version": "0.1.0",
  "description": "Graphical launcher for the Afterhours 2015 local server and game",
  "license": "MPL-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tokens": "node scripts/tokens.mjs",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/saira-semi-condensed": "5.3.0",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-dialog": "2.8.3",
    "@tauri-apps/plugin-opener": "2.7.2"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tauri-apps/cli": "2.12.3",
    "@types/node": "24.19.2",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.57.2",
    "svelte-check": "4.7.6",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@10.32.1"
}
